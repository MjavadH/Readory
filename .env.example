# Compose project
COMPOSE_PROJECT_NAME=readory

# PostgreSQL
POSTGRES_DB=readory
POSTGRES_USER=readory
POSTGRES_PASSWORD=change_me_postgres_password
DATABASE_URL=postgresql://readory:change_me_postgres_password@postgres:5432/readory?schema=public

# Backend URLs and auth
NODE_ENV=production
PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3001
JWT_SECRET=replace_with_strong_random_jwt_secret
JWT_EXPIRES_IN=604800
REFRESH_TOKEN_EXPIRES_IN=2592000
SESSION_INACTIVITY_TIMEOUT_SECONDS=15552000
USER_MAX_DEVICES=10
ADMIN_JWT_EXPIRES_IN=900
ADMIN_REFRESH_TOKEN_EXPIRES_IN=43200
ADMIN_MAX_DEVICES=3
SUPER_ADMIN_ID=1
SEED_ADMIN_PASSWORD=replace_with_seed_only_admin_password
GOOGLE_CLIENT_ID=your_client_id_here.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_client_id_here.apps.googleusercontent.com

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# S3-compatible storage (MinIO in Compose)
MINIO_ROOT_USER=readory_minio
MINIO_ROOT_PASSWORD=change_me_minio_password
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=readory_minio
S3_SECRET_ACCESS_KEY=change_me_minio_password
S3_BUCKET_NAME=readory-book
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=http://localhost:9000/readory-book
S3_AUTO_CREATE_BUCKET=true
NEXT_PUBLIC_S3_PUBLIC_BASE_URL=http://localhost:9000/readory-book

# Meilisearch
MEILI_MASTER_KEY=change_me_meili_master_key_at_least_16_bytes
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_API_KEY=change_me_meili_master_key_at_least_16_bytes

# Mail
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_USER=notifications@example.com
MAIL_PASSWORD=replace_with_mail_password
MAIL_FROM="Readory Support <notifications@example.com>"

# App limits/workers
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
USER_COLLECTION_LIMIT=25
USER_COLLECTION_BOOK_LIMIT=100
SCHEDULED_PUBLICATION_CONCURRENCY=5
NOTIFICATION_BATCH_SIZE=500
NOTIFICATION_WORKER_INTERVAL_MS=5000
NOTIFICATION_WORKER_BATCH_SIZE=10
NOTIFICATION_WORKER_CONCURRENCY=3
NOTIFICATION_LEASE_HEARTBEAT_MS=15000
NOTIFICATION_LEASE_MS=60000
NOTIFICATION_MAX_ATTEMPTS=8
NOTIFICATION_RETRY_BASE_MS=30000
NOTIFICATION_RETENTION_DAYS=180
NOTIFICATION_CLEANUP_BATCH_SIZE=1000
NOTIFICATION_BROADCAST_MAX_SELECTED_USERS=5000
PDF_PROCESSING_CONCURRENCY=2

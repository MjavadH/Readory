# Dedicated test database (never use production credentials here)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/readory_test?schema=public"

# App/auth
NODE_ENV="test"
JWT_SECRET="test-jwt-secret"
JWT_EXPIRES_IN="3600"
PORT="3000"

# Redis (unit/controller tests should mock this; values here are placeholders for e2e/integration)
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"

# S3 (unit/controller tests should mock this; values here are placeholders for e2e/integration)
S3_ENDPOINT="http://127.0.0.1:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="test"
S3_SECRET_ACCESS_KEY="test"
S3_BUCKET_NAME="readory-test-bucket"
S3_FORCE_PATH_STYLE="true"
S3_AUTO_CREATE_BUCKET="false"

APP_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:3001"
NEXT_PUBLIC_APP_URL="http://localhost:3001"
CORS_ORIGIN="http://localhost:3001"
REFRESH_TOKEN_EXPIRES_IN="2592000"
SESSION_INACTIVITY_TIMEOUT_SECONDS="15552000"
USER_MAX_DEVICES="10"
ADMIN_JWT_EXPIRES_IN="900"
ADMIN_REFRESH_TOKEN_EXPIRES_IN="43200"
ADMIN_MAX_DEVICES="3"
SUPER_ADMIN_ID="1"
GOOGLE_CLIENT_ID="test-google-client-id.apps.googleusercontent.com"
THROTTLE_TTL_MS="60000"
THROTTLE_LIMIT="120"
MAIL_HOST="smtp.example.test"
MAIL_PORT="465"
MAIL_USER="notifications@example.test"
MAIL_PASSWORD="test"
MAIL_FROM="Readory Test <notifications@example.test>"
USER_COLLECTION_LIMIT="25"
USER_COLLECTION_BOOK_LIMIT="100"
SCHEDULED_PUBLICATION_CONCURRENCY="5"
PDF_PROCESSING_CONCURRENCY="2"
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY="test"
S3_PUBLIC_BASE_URL="http://127.0.0.1:9000/readory-test-bucket"
NOTIFICATION_BATCH_SIZE="500"
NOTIFICATION_WORKER_INTERVAL_MS="5000"
NOTIFICATION_WORKER_BATCH_SIZE="10"

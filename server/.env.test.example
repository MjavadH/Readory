# Dedicated test database (never use production credentials here)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/readory_test?schema=public"

# App/auth
NODE_ENV="test"
JWT_SECRET="test-jwt-secret"
JWT_EXPIRES_IN="3600"
PORT="3000"

# Redis (unit/controller tests should mock this; values here are placeholders for e2e/integration)
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"

# S3 (unit/controller tests should mock this; values here are placeholders for e2e/integration)
S3_ENDPOINT="http://127.0.0.1:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="test"
S3_SECRET_ACCESS_KEY="test"
S3_BUCKET_NAME="readory-test-bucket"
S3_FORCE_PATH_STYLE="true"
S3_AUTO_CREATE_BUCKET="false"

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id    Int      @id @default(autoincrement())
  name  RoleName @unique
  users User[]
}

model User {
  id              Int               @id @default(autoincrement())
  email           String            @unique
  passwordHash    String
  roleId          Int?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  lastLoginAt     DateTime?
  username        String            @unique
  isBanned        Boolean           @default(false)
  permissions     String[]
  accessRecords   AccessRecord[]
  BookRating      BookRating[]
  favoriteBooks   FavoriteBook[]
  readingProgress ReadingProgress[]
  role            Role?             @relation(fields: [roleId], references: [id])
  wallet          Wallet?
}

model Wallet {
  id           Int                 @id @default(autoincrement())
  userId       Int                 @unique
  balance      Decimal             @default(0) @db.Decimal(12, 2)
  user         User                @relation(fields: [userId], references: [id])
  transactions WalletTransaction[]
}

model WalletTransaction {
  id        Int             @id @default(autoincrement())
  walletId  Int
  amount    Decimal         @db.Decimal(12, 2)
  type      TransactionType
  createdAt DateTime        @default(now())
  reference String?
  wallet    Wallet          @relation(fields: [walletId], references: [id])
}

model Book {
  id                Int               @id @default(autoincrement())
  title             String
  description       String?
  coverImage        String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  isFeatured        Boolean           @default(false)
  ratingAvg         Decimal           @default(0) @db.Decimal(3, 2)
  ratingCount       Int               @default(0)
  typeId            Int
  originalTitle     String?
  alternativeTitles String[]          @default([])
  status            String            @default("UPCOMING")
  publishStatus     String            @default("DRAFT")
  ageRating         String?
  publicationYear   Int?
  lastContentUpdate DateTime?
  chapterCount      Int               @default(0)
  favoriteCount     Int               @default(0)
  popularityScore   Decimal           @default(0) @db.Decimal(8, 4)
  AccessRecord      AccessRecord[]
  coverMedia        Media?            @relation(fields: [coverImage], references: [code])
  type              BookType          @relation(fields: [typeId], references: [id])
  genres            BookGenre[]
  contributors      BookContributor[]
  ratings           BookRating[]
  chapters          Chapter[]
  favoritedBy       FavoriteBook[]
  readingProgress   ReadingProgress[]

  @@index([ratingAvg, ratingCount])
  @@index([publishStatus, isFeatured])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([lastContentUpdate])
}

model BookType {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  iconKey   String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  books     Book[]

  @@index([isActive, sortOrder])
}

model BookRating {
  id        Int      @id @default(autoincrement())
  userId    Int
  bookId    Int
  rating    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([bookId])
}

model Genre {
  id            Int         @id @default(autoincrement())
  name          String      @unique
  slug          String      @unique
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  featuredOrder Int         @default(0)
  isFeatured    Boolean     @default(false)
  iconKey       String?
  books         BookGenre[]
}

model BookGenre {
  bookId  Int
  genreId Int
  book    Book  @relation(fields: [bookId], references: [id], onDelete: Cascade)
  genre   Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([bookId, genreId])
  @@index([genreId])
}

model Chapter {
  id              Int                 @id @default(autoincrement())
  bookId          Int
  title           String
  index           Int
  price           Decimal?            @db.Decimal(12, 2)
  isFree          Boolean             @default(false)
  contentPath     String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  contentType     ChapterContentType?
  pageCount       Int                 @default(0)
  contentVersion  Int                 @default(0)
  publishStatus   String              @default("DRAFT")
  accessRecords   AccessRecord[]
  book            Book                @relation(fields: [bookId], references: [id])
  readingProgress ReadingProgress[]

  @@unique([bookId, index])
}

model ReadingProgress {
  id        Int      @id @default(autoincrement())
  userId    Int
  bookId    Int
  chapterId Int
  lastPage  Int      @default(1)
  percent   Int      @default(0)
  updatedAt DateTime @updatedAt
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterId])
  @@index([userId, bookId])
}

model AccessRecord {
  id          Int      @id @default(autoincrement())
  userId      Int
  chapterId   Int
  purchasedAt DateTime @default(now())
  bookId      Int
  Book        Book     @relation(fields: [bookId], references: [id])
  chapter     Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id])

  @@unique([userId, chapterId])
  @@index([userId, purchasedAt])
  @@index([userId, bookId])
}

model Media {
  id         Int      @id @default(autoincrement())
  code       String   @unique
  filename   String   @unique
  mimeType   String
  size       Int
  createdAt  DateTime @default(now())
  storageKey String   @unique
  Book       Book[]
}

model FavoriteBook {
  id        Int      @id @default(autoincrement())
  userId    Int
  bookId    Int
  createdAt DateTime @default(now())
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([userId, createdAt])
}

model Contributor {
  id           Int               @id @default(autoincrement())
  name         String
  originalName String?
  slug         String            @unique
  biography    String?
  gender       ContributorGender @default(UNKNOWN)
  bookCount    Int               @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  books BookContributor[]
}

model BookContributor {
  bookId        Int
  contributorId Int
  role          ContributorRole @default(AUTHOR)

  book        Book        @relation(fields: [bookId], references: [id], onDelete: Cascade)
  contributor Contributor @relation(fields: [contributorId], references: [id], onDelete: Cascade)

  @@id([bookId, contributorId, role])
  @@index([contributorId])
  @@index([bookId])
}

enum RoleName {
  USER
  ADMIN
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum ChapterContentType {
  images
  text
}

enum ContributorGender {
  MALE
  FEMALE
  UNKNOWN
}

enum ContributorRole {
  AUTHOR
  TRANSLATOR
  ILLUSTRATOR
  EDITOR
  CLEANER
  TYPESETTER
  RAW_PROVIDER
  SUPERVISOR
}

model ScheduledPublication {
  id              Int                        @id @default(autoincrement())
  targetType      ScheduledTargetType
  targetId        Int
  publishAt       DateTime
  status          ScheduledPublicationStatus @default(Pending)
  statusChangedAt DateTime?
  retryCount      Int                        @default(0)
  maxRetries      Int                        @default(3)
  lastAttemptAt   DateTime?
  error           String?
  createdById     Int?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@index([status, publishAt])
  @@index([targetType, targetId])
}

enum ScheduledPublicationStatus {
  Pending
  Processing
  Published
  Canceled
  FAILED
}

enum ScheduledTargetType {
  BOOK
  Chapter
  BLOG_POST
}

model AuditLog {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now())
  actorId    String?
  actorName  String?
  actorRole  String?
  ipAddress  String?
  userAgent  String?
  action     String
  category   String
  severity   String   @default("INFO")
  targetType String?
  targetId   String?
  targetName String?
  requestId  String?
  metadata   Json?
  before     Json?
  after      Json?
  diff       Json?

  @@index([createdAt])
  @@index([actorId])
  @@index([action])
  @@index([targetType])
  @@index([targetId])
  @@index([category])
  @@index([severity])
  @@index([targetType, targetId])
}

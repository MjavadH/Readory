datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// Enumerations
enum RoleName {
  USER
  ADMIN
}

enum TransactionType {
  CREDIT
  DEBIT
}

// User roles
model Role {
  id    Int      @id @default(autoincrement())
  name  RoleName @unique
  users User[]
}

// Application users
model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  username      String         @unique
  passwordHash  String
  roleId        Int?
  role          Role?          @relation(fields: [roleId], references: [id])
  wallet        Wallet?
  accessRecords AccessRecord[]
  lastLoginAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  isBanned      Boolean        @default(false)
  permissions   String[]
  BookRating    BookRating[]
}

// Wallet for each user
model Wallet {
  id           Int                 @id @default(autoincrement())
  userId       Int                 @unique
  user         User                @relation(fields: [userId], references: [id])
  balance      Decimal             @default(0) @db.Decimal(12, 2)
  transactions WalletTransaction[]
}

// Individual wallet transactions
model WalletTransaction {
  id        Int             @id @default(autoincrement())
  walletId  Int
  wallet    Wallet          @relation(fields: [walletId], references: [id])
  amount    Decimal         @db.Decimal(12, 2)
  type      TransactionType
  createdAt DateTime        @default(now())
  reference String?
}

// Books
model Book {
  id          Int      @id @default(autoincrement())
  title       String
  author      String?
  description String?
  typeId      Int
  type        BookType @relation(fields: [typeId], references: [id], onDelete: Restrict)
  // Stores Media.code
  coverImage  String?
  coverMedia  Media?   @relation(fields: [coverImage], references: [code], onDelete: SetNull)

  isPublished Boolean     @default(false)
  isFeatured  Boolean     @default(false)
  chapters    Chapter[]
  genres      BookGenre[]

  ratingAvg   Decimal @default(0) @db.Decimal(3, 2)
  ratingCount Int     @default(0)

  ratings BookRating[]

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  AccessRecord AccessRecord[]

  @@index([ratingAvg, ratingCount])
  @@index([isPublished, isFeatured])
  @@index([createdAt])
  @@index([updatedAt])
}

model BookType {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  iconKey   String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  books     Book[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model BookRating {
  id        Int      @id @default(autoincrement())
  userId    Int
  bookId    Int
  rating    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([bookId])
}

model Genre {
  id            Int         @id @default(autoincrement())
  name          String      @unique
  slug          String      @unique
  iconKey       String?
  isFeatured    Boolean     @default(false)
  featuredOrder Int         @default(0)
  books         BookGenre[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model BookGenre {
  bookId  Int
  genreId Int

  book  Book  @relation(fields: [bookId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([bookId, genreId])
  @@index([genreId])
}

// Chapters of each book
model Chapter {
  id            Int            @id @default(autoincrement())
  bookId        Int
  book          Book           @relation(fields: [bookId], references: [id])
  title         String
  index         Int
  price         Decimal?       @db.Decimal(12, 2)
  isFree        Boolean        @default(false)
  contentPath   String? // path to stored images or PDF
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  accessRecords AccessRecord[]

  @@unique([bookId, index])
}

// Records of which users purchased which chapters
model AccessRecord {
  id          Int      @id @default(autoincrement())
  userId      Int
  chapterId   Int?
  user        User     @relation(fields: [userId], references: [id])
  chapter     Chapter? @relation(fields: [chapterId], references: [id])
  purchasedAt DateTime @default(now())
  Book        Book?    @relation(fields: [bookId], references: [id])
  bookId      Int?

  @@unique([userId, chapterId])
  @@index([userId, purchasedAt])
}

model Media {
  id         Int      @id @default(autoincrement())
  code       String   @unique
  filename   String   @unique
  storageKey String   @unique
  mimeType   String
  size       Int
  createdAt  DateTime @default(now())
  Book       Book[]
}

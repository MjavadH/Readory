<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="supported-color-schemes" content="light dark" />
    <title>Readory — Password Reset</title>
    <style>
      body { margin: 0; padding: 0; background-color: #f4f4f7; }
      .wrapper { width: 100%; background-color: #f4f4f7; padding: 24px 12px; }
      .card {
        width: 100%;
        max-width: 520px;
        margin: 0 auto;
        background-color: #ffffff;
        border: 1px solid #e6e6ef;
        border-radius: 14px;
        overflow: hidden;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      }
      .header { padding: 28px 28px 8px; text-align: center; }
      .brand { margin: 0; font-size: 22px; font-weight: 700; color: #111827; letter-spacing: -0.2px; }
      .content { padding: 8px 28px 28px; }
      h1 { margin: 16px 0 8px; font-size: 20px; line-height: 1.35; color: #111827; }
      p { margin: 0 0 14px; font-size: 15px; line-height: 1.65; color: #4b5563; }
      .btn-wrap { text-align: center; padding: 12px 0 6px; }
      .btn {
        display: inline-block;
        padding: 14px 28px;
        background-color: #4f46e5;
        color: #ffffff !important;
        text-decoration: none;
        font-size: 15px;
        font-weight: 600;
        border-radius: 10px;
      }
      .fallback {
        margin-top: 18px;
        padding: 12px 14px;
        background-color: #f7f7fb;
        border: 1px solid #ececf5;
        border-radius: 10px;
        font-size: 12px;
        line-height: 1.6;
        color: #6b7280;
        word-break: break-all;
      }
      .fallback a { color: #4f46e5; }
      .divider { height: 1px; background-color: #ececf5; margin: 22px 0 16px; border: 0; }
      .muted { font-size: 12px; color: #9ca3af; margin: 0; }
      .footer { padding: 0 28px 26px; text-align: center; }

      @media (max-width: 480px) {
        .header, .content, .footer { padding-left: 18px; padding-right: 18px; }
        h1 { font-size: 18px; }
        .btn { display: block; padding: 14px 18px; }
      }

      @media (prefers-color-scheme: dark) {
        body, .wrapper { background-color: #0b0b12 !important; }
        .card { background-color: #14141d !important; border-color: #262633 !important; }
        .brand, h1 { color: #f5f5f7 !important; }
        p { color: #b6b6c4 !important; }
        .fallback { background-color: #1b1b26 !important; border-color: #2a2a38 !important; color: #9a9aac !important; }
        .fallback a { color: #a5b4fc !important; }
        .divider { background-color: #2a2a38 !important; }
        .muted { color: #7c7c8c !important; }
        .btn { background-color: #6366f1 !important; }
      }
    </style>
  </head>
  <body>
    <div class="wrapper">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td align="center">
            <div class="card">
              <div class="header">
                <p class="brand">Readory</p>
              </div>

              <div class="content">
                <h1>Reset your password</h1>

                <p>
                  We received a request to reset the password for your Readory account.
                  Click the button below to choose a new password.
                </p>

                <div class="btn-wrap">
                  <a class="btn" href="<%= locals.resetUrl || locals.context?.resetUrl %>" target="_blank" rel="noopener noreferrer">
                    Reset password
                  </a>
                </div>

                <p style="text-align: center; font-size: 13px;">
                  This link expires in
                  <strong>15 minutes</strong>
                  and can only be used once.
                </p>

                <div class="fallback">
                  Button not working? Copy and paste this URL into your browser:<br />
                  <a href="<%= locals.resetUrl || locals.context?.resetUrl %>" target="_blank" rel="noopener noreferrer"><%= locals.resetUrl || locals.context?.resetUrl %></a>
                </div>

                <hr class="divider" />

                <p class="muted">
                  If you didn’t request a password reset, you can safely ignore this email —
                  your password will stay the same.
                </p>
              </div>

              <div class="footer">
                <p class="muted">© <%= new Date().getFullYear() %> Readory. All rights reserved.</p>
              </div>
            </div>
          </td>
        </tr>
      </table>
    </div>
  </body>
</html>

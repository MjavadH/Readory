# PostgresSQL connection string
DATABASE_URL=""

# Secret key used to sign JSON Web Tokens (JWT). Use a strong random string here.
JWT_SECRET=""

# Token expiry
JWT_EXPIRES_IN="604800"

# Port your NestJS server should run on
PORT=3000

# Comma-separated list of allowed CORS origins
CORS_ORIGIN=http://localhost:3001

# Admin seed password (used only by prisma/seed.ts, min 8 chars)
SEED_ADMIN_PASSWORD=

REDIS_HOST=
REDIS_PORT=6379

SUPER_ADMIN_ID=1

S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_CHAPTERS=readory-book
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=
S3_AUTO_CREATE_BUCKET=true

# mail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USER=your_company_email@gmail.com
MAIL_PASSWORD=your_16_digit_app_password
MAIL_FROM="Readory Support <your_company_email@gmail.com>"
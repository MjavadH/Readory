# Runtime
NODE_ENV=production
PORT=3000
APP_URL=https://api.example.com
FRONTEND_URL=https://example.com
CORS_ORIGIN=https://example.com

# PostgreSQL connection string
DATABASE_URL=postgresql://readory:change_me@localhost:5432/readory?schema=public

# Authentication (replace with a strong random secret in each environment)
JWT_SECRET=replace_with_strong_random_jwt_secret
JWT_EXPIRES_IN="604800"
SUPER_ADMIN_ID=1

# Optional Prisma seed admin password (used only by prisma/seed.ts; minimum 8 characters)
SEED_ADMIN_PASSWORD=replace_with_seed_only_admin_password

# GOOGLE
GOOGLE_CLIENT_ID=your_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret_here

# Redis
REDIS_HOST=
REDIS_PORT=6379

# Rate limiting
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# S3-compatible object storage
S3_ENDPOINT=https://s3.example.com
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=replace_with_access_key_id
S3_SECRET_ACCESS_KEY=replace_with_secret_access_key
S3_BUCKET_NAME=readory-book
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=https://cdn.example.com
S3_AUTO_CREATE_BUCKET=false

# Mail
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_USER=notifications@example.com
MAIL_PASSWORD=replace_with_mail_password
MAIL_FROM="Readory Support <notifications@example.com>"

# Collections
USER_COLLECTION_LIMIT=25
USER_COLLECTION_BOOK_LIMIT=100

# Scheduled publishing worker
SCHEDULED_PUBLICATION_CONCURRENCY=5

# Notifications
NOTIFICATION_BATCH_SIZE=500
NOTIFICATION_WORKER_INTERVAL_MS=5000
NOTIFICATION_WORKER_BATCH_SIZE=10
NOTIFICATION_WORKER_CONCURRENCY=3
NOTIFICATION_LEASE_HEARTBEAT_MS=15000
NOTIFICATION_LEASE_MS=60000
NOTIFICATION_MAX_ATTEMPTS=8
NOTIFICATION_RETRY_BASE_MS=30000
NOTIFICATION_RETENTION_DAYS=180
NOTIFICATION_CLEANUP_BATCH_SIZE=1000
NOTIFICATION_BROADCAST_MAX_SELECTED_USERS=5000
{
  "name": "readory-monorepo",
  "private": true,
  "workspaces": [
    "server",
    "frontend",
    "shared"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "typescript": "^5.7.0"
  },
  "scripts": {
    "build": "npm -ws run build",
    "dev:shared": "npm --workspace @readory/shared run dev",
    "build:shared": "npm --workspace @readory/shared run build",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write ."
  },
  "dependencies": {
    "framer-motion": "^12.34.3"
  }
}
